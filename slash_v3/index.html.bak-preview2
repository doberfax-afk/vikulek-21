<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>РАЗРЕЗ</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%;background:#000;overflow:hidden}

  body{
    font-family:'Courier New',monospace;
    color:#e8e8e8;
    -webkit-font-smoothing:antialiased;
  }

  /* ============ СЦЕНА ============ */
  .stage{
    position:relative;
    width:100%;
    height:100dvh;
    overflow:hidden;
    background:#000;
  }

  /* арт — с РВАНЫМ разрезом через clip-path polygon */
  .art{
    position:absolute;
    top:14px;
    left:0;
    width:100%;
    height:auto;
    max-height:60vh;
    object-fit:contain;
    object-position:top center;
    filter:contrast(1.05) saturate(.95);
    /* старт: узкая рваная щель по центру */
    clip-path:polygon(
      49% 0%, 50% 4%, 49.6% 9%, 50.4% 14%, 49.8% 20%,
      50.6% 26%, 49.4% 32%, 50.2% 38%, 49.6% 44%,
      50.8% 50%, 49.8% 56%, 50.4% 62%, 49.5% 68%,
      50.3% 74%, 49.7% 80%, 50.5% 86%, 49.9% 92%, 50% 100%,
      50.1% 100%, 50.5% 92%, 49.9% 86%, 50.7% 80%, 50.1% 74%,
      50.9% 68%, 50.1% 62%, 50.7% 56%, 49.7% 50%, 50.9% 44%,
      50.3% 38%, 51.1% 32%, 49.9% 26%, 50.7% 20%, 50.1% 14%,
      50.9% 9%, 50.5% 4%, 51% 0%
    );
    animation:slashOpen 2.7s cubic-bezier(.18,.86,.3,1) .5s forwards;
    will-change:clip-path;
  }

  /* рваные края: зубцы чередуются, как настоящий порез ножом */
  @keyframes slashOpen{
    0%{
      clip-path:polygon(
        49% 0%, 50% 4%, 49.6% 9%, 50.4% 14%, 49.8% 20%,
        50.6% 26%, 49.4% 32%, 50.2% 38%, 49.6% 44%,
        50.8% 50%, 49.8% 56%, 50.4% 62%, 49.5% 68%,
        50.3% 74%, 49.7% 80%, 50.5% 86%, 49.9% 92%, 50% 100%,
        50.1% 100%, 50.5% 92%, 49.9% 86%, 50.7% 80%, 50.1% 74%,
        50.9% 68%, 50.1% 62%, 50.7% 56%, 49.7% 50%, 50.9% 44%,
        50.3% 38%, 51.1% 32%, 49.9% 26%, 50.7% 20%, 50.1% 14%,
        50.9% 9%, 50.5% 4%, 51% 0%);
    }
    30%{
      clip-path:polygon(
        44% 0%, 45.2% 5%, 44.4% 11%, 45.8% 17%, 44.9% 23%,
        46.1% 29%, 44.2% 35%, 45.5% 41%, 44.7% 47%,
        46.3% 53%, 44.9% 59%, 45.8% 65%, 44.3% 71%,
        45.6% 77%, 44.8% 83%, 46% 89%, 45% 95%, 44.6% 100%,
        55.4% 100%, 55.9% 94%, 54.7% 88%, 55.8% 82%,
        55%  76%, 56.2% 70%, 54.9% 64%, 55.7% 58%,
        54.3% 52%, 55.9% 46%, 55.1% 40%, 56.2% 34%,
        54.8% 28%, 55.6% 22%, 54.4% 16%, 55.5% 10%,
        54.7% 5%, 55.9% 0%);
    }
    70%{
      clip-path:polygon(
        26% 0%, 28.5% 7%, 26.8% 15%, 29.2% 23%, 27.4% 31%,
        29.8% 39%, 26.6% 47%, 28.9% 55%, 27.1% 63%,
        29.5% 71%, 26.9% 79%, 28.7% 87%, 27.3% 94%, 27.6% 100%,
        72.4% 100%, 72.9% 93%, 71.2% 85%, 73.4% 77%,
        71.6% 69%, 73.8% 61%, 70.9% 53%, 73.1% 45%,
        70.8% 37%, 73.6% 29%, 71.4% 21%, 73.2% 13%,
        71%  6%, 73.5% 0%);
    }
    100%{
      clip-path:polygon(
        0% 0%, 3% 6%, 1% 13%, 4% 20%, 2% 28%,
        5% 36%, 1% 44%, 3% 52%, 2% 60%,
        4% 68%, 1% 76%, 3% 84%, 2% 92%, 0% 100%,
        100% 100%, 99% 92%, 100% 84%, 98% 76%,
        99% 68%, 100% 60%, 98% 52%, 99% 44%,
        100% 36%, 98% 28%, 99% 20%, 100% 13%,
        98% 6%, 100% 0%);
    }
  }

  /* тьма поверх — уходит по мере разреза */
  .shroud{
    position:absolute;
    inset:0;
    background:#000;
    animation:shroudFade 2.6s ease .5s forwards;
    pointer-events:none;
  }
  @keyframes shroudFade{
    0%{opacity:1}
    100%{opacity:.42}
  }

  /* линия реза — яркий шов */
  .seam{
    position:absolute;
    top:0;
    bottom:0;
    left:50%;
    width:2px;
    transform:translateX(-50%);
    background:linear-gradient(180deg,
      rgba(255,255,255,0) 0%,
      rgba(255,255,255,.95) 12%,
      rgba(255,255,255,1) 50%,
      rgba(255,255,255,.95) 88%,
      rgba(255,255,255,0) 100%);
    box-shadow:0 0 24px 6px rgba(255,255,255,.55),
               0 0 60px 18px rgba(120,200,255,.22);
    animation:seamOut 2.2s ease .5s forwards;
    pointer-events:none;
    z-index:3;
  }
  @keyframes seamOut{
    0%  {opacity:0;width:0}
    12% {opacity:1;width:2px}
    70% {opacity:1;width:2px}
    100%{opacity:0;width:3px}
  }

  /* ============ ЦИФРЫ 18.11.2026 ============ */
  .date{
    position:absolute;
    left:50%;
    top:75%;
    transform:translate(-50%,-50%);
    z-index:5;
    font-family:'Courier New',monospace;
    font-size:clamp(30px,9.5vw,88px);
    font-weight:700;
    letter-spacing:.14em;
    color:#fff;
    text-shadow:0 0 18px rgba(140,215,255,.85),
                0 0 46px rgba(80,170,255,.5),
                0 0 90px rgba(40,110,255,.3);
    white-space:nowrap;
    opacity:0;
    animation:dateIn 1.1s ease 2.1s forwards, glitch 5s steps(1) 3.2s infinite;
  }

  @keyframes dateIn{
    0%  {opacity:0; transform:translate(-50%,-50%) scale(.9); filter:blur(8px)}
    40% {opacity:1; transform:translate(-50%,-50%) scale(1.02); filter:blur(0)}
    100%{opacity:1; transform:translate(-50%,-50%) scale(1)}
  }

  @keyframes glitch{
    0%,88%,100%{ transform:translate(-50%,-50%) translate(0,0); text-shadow:0 0 18px rgba(140,215,255,.85),0 0 46px rgba(80,170,255,.5) }
    89%{ transform:translate(-50%,-50%) translate(-3px,1px); text-shadow:-3px 0 rgba(255,60,120,.9), 3px 0 rgba(60,255,220,.9) }
    90%{ transform:translate(-50%,-50%) translate(3px,-1px); text-shadow:3px 0 rgba(255,60,120,.9), -3px 0 rgba(60,255,220,.9) }
    91%{ transform:translate(-50%,-50%) translate(0,0) }
  }

  /* ============ ТЕКСТ ============ */
  .copy{
    position:absolute;
    left:0;right:0;
    bottom:clamp(76px,11vh,120px);
    z-index:6;
    text-align:center;
    padding:0 6vw;
    opacity:0;
    animation:copyIn 1.2s ease 3.1s forwards;
  }

  @keyframes copyIn{
    from{opacity:0; transform:translateY(16px)}
    to  {opacity:1; transform:translateY(0)}
  }

  .copy p{
    display:inline-block;
    font-size:clamp(14px,3.9vw,18px);
    line-height:1.6;
    letter-spacing:.02em;
    color:#f6fafe;
    font-weight:800;
    background:rgba(4,7,12,.62);
    padding:6px 14px;
    border-radius:3px;
    backdrop-filter:blur(2px);
    text-shadow:0 1px 3px #000, 0 0 12px #000;
    margin-bottom:.4em;
  }
  .copy p:last-child{
    color:#a9bdd1;
    font-size:clamp(11px,3.1vw,14px);
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  /* ============ КНОПКА ============ */
  .enter{
    position:absolute;
    left:50%;
    bottom:calc(clamp(26px,4.6vh,44px) + env(safe-area-inset-bottom,0px));
    transform:translateX(-50%);
    z-index:7;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:13px 40px 13px 48px;
    /* кабельный ТВ: тёмный пластик с блик-градиентом */
    background:linear-gradient(180deg,
      rgba(46,58,74,.95) 0%,
      rgba(22,30,42,.97) 46%,
      rgba(11,16,24,.98) 100%);
    border:1px solid rgba(150,196,232,.42);
    border-radius:3px;
    box-shadow:
      0 1px 0 rgba(190,225,255,.22) inset,
      0 -1px 0 rgba(0,0,0,.85) inset,
      0 10px 26px rgba(0,0,0,.65),
      0 0 0 1px rgba(0,0,0,.55),
      0 0 22px rgba(90,160,230,.18);
    color:#e8f2fb;
    font-family:"Courier New",monospace;
    font-size:clamp(12px,3.2vw,14px);
    font-weight:700;
    letter-spacing:.24em;
    text-transform:uppercase;
    cursor:pointer;
    opacity:0;
    animation:btnIn 1s ease 3.4s forwards;
    text-shadow:0 1px 0 rgba(0,0,0,.85), 0 -1px 0 rgba(255,255,255,.14);
    transition:box-shadow .28s, border-color .28s, transform .18s, background .28s;
  }

  /* красный индикатор "REC" — как на деке */
  .enter::before{
    content:"";
    position:absolute;
    left:16px;
    top:50%;
    margin-top:-4px;
    width:8px;height:8px;
    border-radius:50%;
    background:radial-gradient(circle at 34% 28%, #fff2ee 0%, #ff6a55 18%, #d81e10 52%, #6d0c06 100%);
    box-shadow:
      inset 0 1px 1px rgba(255,255,255,.65),
      inset 0 -1px 2px rgba(0,0,0,.6),
      0 0 7px rgba(255,70,45,.95),
      0 0 20px rgba(215,40,18,.5);
    animation:recBlink 1.6s steps(1,end) infinite;
    flex:0 0 auto;
  }

  @keyframes recBlink{
    0%,55%{opacity:1}
    56%,100%{opacity:.18}
  }

  /* шагрень пластика */
  .enter{
    background-blend-mode:normal;
  }

  /* внутренняя рамка-экран */
  .enter::after{
    content:"";
    position:absolute;
    inset:4px;
    border:1px solid rgba(120,170,215,.16);
    border-radius:1px;
    pointer-events:none;
    background-image:repeating-linear-gradient(
      0deg, rgba(255,255,255,.028) 0px, rgba(255,255,255,.028) 1px,
      rgba(0,0,0,.05) 1px, rgba(0,0,0,.05) 2px);
  }

  .enter:hover,.enter:active{
    border-color:rgba(200,232,255,.78);
    background:linear-gradient(180deg,
      rgba(58,74,94,.96) 0%,
      rgba(27,37,52,.97) 46%,
      rgba(13,19,29,.98) 100%);
    box-shadow:
      0 1px 0 rgba(200,232,255,.32) inset,
      0 -1px 0 rgba(0,0,0,.85) inset,
      0 12px 30px rgba(0,0,0,.7),
      0 0 0 1px rgba(0,0,0,.55),
      0 0 34px rgba(110,180,255,.42);
    transform:translateX(-50%) translateY(-1px);
  }

  .enter:active{
    transform:translateX(-50%) translateY(1px);
    box-shadow:
      0 1px 6px rgba(0,0,0,.9) inset,
      0 0 0 1px rgba(0,0,0,.6),
      0 0 18px rgba(90,160,230,.25);
  }

  @keyframes btnIn{
    from{opacity:0; transform:translateX(-50%) translateY(10px)}
    to  {opacity:1; transform:translateX(-50%) translateY(0)}
  }

  .enter:hover,.enter:focus-visible{
    background:rgba(140,205,255,.14);
    border-color:rgba(190,230,255,.95);
    color:#fff;
    box-shadow:0 0 28px rgba(120,190,255,.45), inset 0 0 20px rgba(120,190,255,.12);
    outline:none;
  }
  .enter:active{ transform:translateX(-50%) scale(.97) }

  /* ============ СКАНЛАЙНЫ / ЗЕРНО ============ */
  .scanlines{
    position:absolute;
    inset:0;
    z-index:8;
    pointer-events:none;
    background:repeating-linear-gradient(
      to bottom,
      rgba(0,0,0,0) 0px,
      rgba(0,0,0,0) 2px,
      rgba(0,0,0,.22) 3px,
      rgba(0,0,0,.22) 4px);
    mix-blend-mode:multiply;
    opacity:.55;
  }

  .vignette{
    position:absolute;
    inset:0;
    z-index:8;
    pointer-events:none;
    background:radial-gradient(ellipse at 50% 45%,
      rgba(0,0,0,0) 32%,
      rgba(0,0,0,.55) 72%,
      rgba(0,0,0,.92) 100%);
  }

  /* ============ МОБИЛЬНАЯ АДАПТАЦИЯ ============ */
  @media (orientation:portrait) and (max-width:900px){
    .art{ object-position:center 42%; }
    .date{ font-size:clamp(26px,10.5vw,64px); letter-spacing:.1em; top:71%; }
    .copy{ bottom:clamp(88px,12vh,130px); }
    .copy p{ font-size:15.5px; line-height:1.55; }
    .enter{ padding:14px 38px; letter-spacing:.28em; }
    .scanlines{ opacity:.42; }
  }

  /* маленькие экраны по высоте */
  @media (max-height:640px){
    .copy{ bottom:76px }
    .copy p{ font-size:14px; line-height:1.5 }
    .copy p:last-child{ font-size:10.5px }
    .enter{ bottom:20px; padding:12px 32px }
    .date{ font-size:clamp(24px,8vw,52px) }
  }

  @media (prefers-reduced-motion:reduce){
    .art{ animation:none; clip-path:inset(0 0 0 0) }
    .shroud{ animation:none; opacity:.42 }
    .seam{ display:none }
    .date{ animation:dateIn .01s forwards; }
    .copy,.enter{ animation:none; opacity:1 }
  }
</style>
</head>
<body>

<div class="stage">
  <img class="art" src="img/intro_slash_v2.png" alt="">
  <div class="shroud"></div>
  <div class="seam"></div>

  <div class="date">18.11.2026</div>

  <div class="copy">
    <p>Есть дата, которую нельзя отменить.</p>
    <p>Пролистай — и узнаешь, почему.</p>
  </div>

  <button class="enter" type="button" onclick="enterStory()">Войти</button>

  <div class="vignette"></div>
  <div class="scanlines"></div>
</div>

<script>
function enterStory(){
  // пока заглушка: подсветка + переход дальше появится, когда будет акт I
  const btn = document.querySelector('.enter');
  btn.textContent = 'Дальше...';
  btn.disabled = true;
  document.body.style.transition = 'opacity .6s ease';
  document.body.style.opacity = '0';
  setTimeout(function(){
    // сюда придёт переход на акт I
    document.body.style.opacity = '1';
    btn.textContent = 'Войти';
    btn.disabled = false;
  }, 1400);
}

// повторный запуск анимации по тапу (для демонстрации)
document.querySelector('.stage').addEventListener('click', function(e){
  if(e.target.closest('.enter')) return;
  const art = document.querySelector('.art');
  const seam = document.querySelector('.seam');
  const shroud = document.querySelector('.shroud');
  const date = document.querySelector('.date');
  [art,seam,shroud,date].forEach(function(el){
    el.style.animation = 'none';
    void el.offsetWidth;
    el.style.animation = '';
  });
});
</script>

</body>
</html>
